# Production Environment Configuration
# DO NOT commit this file to version control
# Copy this to .env and update with your actual values

# Application Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (will be overridden by AWS Secrets Manager)
MONGODB_URI=mongodb://admin:password@docdb-cluster.amazonaws.com:27017/exam-module?ssl=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Security Configuration (will be overridden by AWS Secrets Manager)
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# AWS Configuration (optional - can be set via IAM roles)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Application Features
ENABLE_PROCTORING=true
ENABLE_ANALYTICS=true
ENABLE_FILE_UPLOAD=true
MAX_FILE_SIZE=50mb

# Session Configuration
SESSION_TIMEOUT=3600000
EXAM_TIMEOUT_WARNING=300000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
