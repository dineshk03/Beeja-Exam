{
  "name": "exam-module",
  "version": "3.0.0",
  "description": "Enterprise-grade exam management system with advanced proctoring and analytics",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "build:prod": "NODE_ENV=production vite build",
    "deploy": "npm run build:prod && npm run start",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/tests/**/*.test.js'",
    "lint": "eslint server src --ext .js,.jsx",
    "lint:fix": "eslint server src --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "docker:build": "docker build -t exam-portal:latest -f Dockerfile.production .",
    "docker:run": "docker-compose -f docker-compose.production.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.production.yml down",
    "backup:db": "node scripts/backup-database.js",
    "email:test": "node scripts/test-email.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.284.0",
    "mongoose": "^7.8.7",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "recharts": "^2.15.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "exam",
    "assessment",
    "proctoring",
    "education",
    "testing",
    "quiz",
    "mongodb",
    "react",
    "nodejs"
  ],
  "author": "Exam Portal Team",
  "license": "MIT"
}